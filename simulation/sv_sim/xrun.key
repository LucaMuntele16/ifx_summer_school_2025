# Restoring simulation environment...
input -quiet .reinvoke.sim
file delete .reinvoke.sim
probe -create -shm ifx_dig_top.DUT.acc_en_i ifx_dig_top.DUT.addr_i ifx_dig_top.DUT.clk_i ifx_dig_top.DUT.data_in ifx_dig_top.DUT.data_out ifx_dig_top.DUT.filter_type_s ifx_dig_top.DUT.in_int_s ifx_dig_top.DUT.int_en_s ifx_dig_top.DUT.int_pulse_out ifx_dig_top.DUT.rdata_o ifx_dig_top.DUT.rstn_i ifx_dig_top.DUT.sync_data_out_s ifx_dig_top.DUT.wd_rst_s ifx_dig_top.DUT.wdata_i ifx_dig_top.DUT.window_size_s ifx_dig_top.DUT.wr_en_i
run
