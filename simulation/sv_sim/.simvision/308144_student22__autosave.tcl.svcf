
#
# Preferences
#
preferences set plugin-enable-svdatabrowser-new 1
preferences set plugin-enable-groupscope 0
preferences set plugin-enable-interleaveandcompare 0
preferences set plugin-enable-waveformfrequencyplot 0

#
# Mnemonic Maps
#
mmap new  -reuse -name {Boolean as Logic} -radix %b -contents {{%c=FALSE -edgepriority 1 -shape low}
{%c=TRUE -edgepriority 1 -shape high}}
mmap new  -reuse -name {Example Map} -radix %x -contents {{%b=11???? -bgcolor orange -label REG:%x -linecolor yellow -shape bus}
{%x=1F -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=2C -bgcolor red -label ERROR -linecolor white -shape EVENT}
{%x=* -label %x -linecolor gray -shape bus}}

#
# Design Browser windows
#
if {[catch {window new WatchList -name "Design Browser 1" -geometry 1920x1009+0+23}] != ""} {
    window geometry "Design Browser 1" 1920x1009+0+23
}
window target "Design Browser 1" on
browser using {Design Browser 1}
browser set -scope  simulator:: 
browser set \
    -signalsort name
browser yview see  simulator:: 
browser timecontrol set -lock 0

#
# Waveform windows
#
if {[catch {window new WaveWindow -name "Waveform 1" -geometry 1244x790+387+75}] != ""} {
    window geometry "Waveform 1" 1244x790+387+75
}
window target "Waveform 1" on
waveform using {Waveform 1}
waveform sidebar select designbrowser
waveform set \
    -primarycursor TimeA \
    -signalnames name \
    -signalwidth 175 \
    -units ps \
    -valuewidth 75
waveform baseline set -time 0

set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.ADDR_SIZE
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.N
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.NUM_STATUS_REGS
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.acc_en_i
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.addr_i[4:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.clk_i
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.data_in[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.data_out[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.filter_type_s[31:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.in_int_s[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.int_en_s[15:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.int_pulse_out
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.rdata_o[7:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.rstn_i
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.sync_data_out_s[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.wd_rst_s[15:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.wdata_i[7:0]}
	} ]
set id [waveform add -signals  {
	{simulator::ifx_dig_top.DUT.window_size_s[63:0]}
	} ]
set id [waveform add -signals  {
	simulator::ifx_dig_top.DUT.wr_en_i
	} ]

waveform xview limits 99998000ps 100000000ps

#
# Waveform Window Links
#

#
# Console windows
#
console set -windowname Console
window geometry Console 730x250+0+0

#
# Layout selection
#
